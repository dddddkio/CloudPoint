# ============================================================
# CloudPoint backend environment.
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ============================================================

# ---- Database (SQLAlchemy URL) ----
DATABASE_URL=postgresql+psycopg://cloudpoint:change_me@localhost:5432/cloudpoint

# ---- MinIO / S3-compatible object storage ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cloudpoint
MINIO_SECRET_KEY=change_me_too
MINIO_SECURE=false
MINIO_BUCKET=pointclouds

# ---- App ----
# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=500
