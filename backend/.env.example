# ============================================================
# CloudPoint backend environment.
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ============================================================

# ---- Database (SQLAlchemy URL) ----
DATABASE_URL=postgresql+psycopg://cloudpoint:change_me@localhost:5432/cloudpoint

# ---- MinIO / S3-compatible object storage ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cloudpoint
MINIO_SECRET_KEY=change_me_too
MINIO_SECURE=false
MINIO_BUCKET=pointclouds

# ---- App ----
APP_NAME=CloudPoint API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# json for production ingestion; text for easier local reading.
LOG_FORMAT=json
# Local only. Production must use AUTH_MODE=cloudflare_access.
AUTH_MODE=development
# Production values from Zero Trust > Access > Applications.
# AUTH_MODE=cloudflare_access
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUDIENCE=your-application-aud-tag
# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=500
